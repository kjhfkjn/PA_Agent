{
  "manifest_version": 3,
  "name": "PA Agent · TradingView Chart Reader",
  "version": "0.1.8",
  "description": "Read and validate candles from an open TradingView chart and send them to the local PA Agent.",
  "key": "",
  "permissions": ["storage", "alarms", "activeTab", "sidePanel", "debugger"],
  "host_permissions": [
    "https://*.tradingview.com/chart/*",
    "http://127.0.0.1:18765/*"
  ],
  "background": { "service_worker": "service_worker.js" },
  "side_panel": { "default_path": "popup.html" },
  "action": { "default_title": "PA Agent · TradingView" },
  "content_scripts": [
    {
      "matches": ["https://*.tradingview.com/chart/*"],
      "js": ["page_reader.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.tradingview.com/chart/*"],
      "js": ["content_relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
